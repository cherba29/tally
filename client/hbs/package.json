{
  "name": "@tally/client",
  "private": true,
  "version": "0.3.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@graphql-codegen/cli": "^6.1.1",
    "@graphql-codegen/typescript": "^5.0.7",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-puppeteer": "^1.0.0",
    "css-loader": "^7.1.3",
    "eslint": "^9.39.2",
    "eslint-config-google": "^0.14.0",
    "nyc": "^15.1.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "dependencies": {
    "@apollo/client": "^4.1.3",
    "@tally/lib": "workspace:*",
    "graphql": "^16.12.0",
    "lit": "^3.3.2",
    "prettier": "^3.8.1"
  },
  "scripts": {
    "test": "web-test-runner --puppeteer",
    "serve": "TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack serve --port 9000",
    "build": "TS_NODE_PROJECT=\"tsconfig-for-webpack-config.json\" webpack --config webpack.config.ts",
    "karma": "karma start karma.conf.js",
    "graphql-codegen": "graphql-codegen --config codegen.yml",
    "coverage": "nyc -r text -e .ts -x \"tests/*.test.ts\" npm run test",
    "prettier-format": "prettier --config .prettierrc.yaml '**/*.ts' --write",
    "lint": "eslint . --ext .ts",
    "lint-fix": "eslint . --ext .ts --fix"
  }
}
